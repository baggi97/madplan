# --- Påkrævet ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Valgfrit ---
ANTHROPIC_MODEL=claude-sonnet-5
WEB_PORT=8099

# Cloudflare Tunnel (valgfrit, men den nemmeste vej til HTTPS).
# Token findes i Zero Trust → Networks → Tunnels → din tunnel → Configure.
CLOUDFLARE_TUNNEL_TOKEN=

# Push-beskeder til telefonerne (valgfrit).
# Lav et nøglepar med:  python -m app.push
# KRÆVER HTTPS på websitet — se README. Tomme nøgler slår push fra.
VAPID_OFFENTLIG_NOEGLE=
VAPID_PRIVAT_NOEGLE=
VAPID_KONTAKT=mailto:dig@eksempel.dk

# Tidsplan: "ugedag time" i lokal tid
FORSLAG_CRON=sun 8
DEADLINE_CRON=sun 18
# Puf hvis ingen har valgt endnu. Skal ligge før deadline.
PAAMINDELSE_CRON=sun 17

ANTAL_FORSLAG=15
ANTAL_RETTER=5

# Hvor mange af forslagene der skal bygge på ugens tilbud. Resten bliver
# sæsonretter — der er sjældent 15 fornuftige retter i én uges tilbud.
MIN_MED_TILBUD=8

# Retter serveret inden for så mange uger foreslås ikke igen
UNDGAA_UGER=4

TZ=Europe/Copenhagen
