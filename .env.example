# --- Påkrævet ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Valgfrit ---
ANTHROPIC_MODEL=claude-sonnet-5
WEB_PORT=8099

# Adressen familien åbner. Bruges kun i Telegram-notifikationen.
BASE_URL=http://192.168.1.50:8099

# Telegram er helt valgfrit — det sender kun et praj med et link.
# Lad felterne stå tomme for at køre uden.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Tidsplan: "ugedag time" i lokal tid
FORSLAG_CRON=sun 8
DEADLINE_CRON=sun 18

ANTAL_FORSLAG=10
ANTAL_RETTER=5

TZ=Europe/Copenhagen
